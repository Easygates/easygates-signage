# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Where to find these in Supabase (the dashboard doesn't say "Supavisor"):
#   1. Open your project and click the green "Connect" button at the top.
#   2. Pick "Transaction pooler" → copy into DATABASE_URL (ends in :6543/postgres).
#   3. Pick "Session pooler"     → copy into DIRECT_URL   (ends in :5432/postgres).
#   Direct links (open the project you last used):
#     https://supabase.com/dashboard/project/_?showConnect=true&method=transaction
#     https://supabase.com/dashboard/project/_?showConnect=true&method=session
#
# Checks:
#   - Username is postgres.[PROJECT-REF] (with the dot), host contains pooler.supabase.com.
#     db.[PROJECT-REF].supabase.co is "Direct connection" — don't use it (IPv6 only).
#   - Copy the host exactly. The number after "aws-" (0, 1, …) varies per project;
#     a wrong one gives "Tenant or user not found".
#   - Replace only [YOUR-PASSWORD]. URL-encode special characters:
#     @ → %40   # → %23   % → %25   ? → %3F   / → %2F   : → %3A
#   - Forgot the password? Project Settings → Database → Reset database password.

# Used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:6543/postgres"
# Used by `npx drizzle-kit push`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[N]-[REGION].pooler.supabase.com:5432/postgres"

# Local PostgreSQL instead:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Optional: Supabase Storage for /api/upload (otherwise files go to public/uploads) ──
# Secret key: Project Settings → API Keys → create a secret key (starts with sb_secret_).
# Server-only — never share it or prefix it with NEXT_PUBLIC_.
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_STORAGE_BUCKET="signage-media"
