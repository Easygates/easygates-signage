# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase: Dashboard → Connect → Supavisor pooler. URL-encode the password.
# Transaction pooler (:6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Session pooler (:5432) — used by `npx drizzle-kit push`.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local PostgreSQL instead:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Optional: Supabase Storage for /api/upload (otherwise files go to public/uploads) ──
# Secret key: Dashboard → Settings → API Keys. Server-only — never prefix with NEXT_PUBLIC_.
# SUPABASE_URL="https://[PROJECT-REF].supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_STORAGE_BUCKET="signage-media"
